.pytest_cache/
.coverage
htmlcov/
*.log
*.lock
*.lock.*

# Notebook, plotting, and compiler caches
.ipynb_checkpoints/
.matplotlib_cache/
**/.matplotlib_cache/
**/_mplconfig/
**/.numba_cache/
**/numba/
results/executed_notebooks/

# Regenerable feature/model caches and local backups
